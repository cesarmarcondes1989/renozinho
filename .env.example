# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Painel do Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# A service role key NUNCA deve ser exposta no cliente. Este projeto não usa
# nenhuma rota de servidor que precise dela, mas caso você adicione uma no
# futuro, guarde-a apenas como variável de ambiente do servidor (sem o
# prefixo NEXT_PUBLIC_) e nunca faça commit dela.
# SUPABASE_SERVICE_ROLE_KEY=
